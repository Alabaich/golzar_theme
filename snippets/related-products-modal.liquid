{% doc %}
Related products modal block for the product page.
Renders its own recommendation cards using block settings.
@param {product} product - Current product
@param {object} block - Related products modal block
@param {object} section - Parent main-product section
@example
{% render 'related-products-modal', product: product, block: block, section: section %}
{% enddoc %}

{%- if product != blank and block != blank -%}
{%- liquid
  assign modal_id = 'related-products-modal-' | append: block.id
  assign products_to_show = block.settings.products_to_show | default: 4
  assign recommendations_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: products_to_show | append: '&intent=related'
-%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  .related-products-modal-placeholder {
    display: none;
  }

  .shopify-design-mode .related-products-modal-placeholder {
    display: block;
    margin: 0.8rem 0;
    padding: 0.8rem 1.2rem;
    border: 1px dashed rgba(18, 18, 18, 0.25);
    border-radius: 0.4rem;
    font-size: 1.3rem;
    opacity: 0.75;
  }

  .related-products-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.6rem;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .related-products-modal.is-open {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
  }

  .related-products-modal__overlay {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    margin: 0;
    background: var(--rpm-overlay-color);
    opacity: var(--rpm-overlay-opacity);
    cursor: pointer;
  }

  .related-products-modal__dialog {
    position: relative;
    z-index: 1;
    width: 100%;
    max-height: min(90vh, 720px);
    overflow: auto;
    background: var(--rpm-dialog-bg, #ffffff);
    color: var(--rpm-dialog-text, #121212);
    border-radius: 0.8rem;
    box-shadow: 0 1.6rem 4.8rem rgba(0, 0, 0, 0.18);
    transform: translateY(1.6rem) scale(0.98);
    transition: transform 0.3s ease;
  }

  .related-products-modal--small .related-products-modal__dialog {
    max-width: 42rem;
  }

  .related-products-modal--medium .related-products-modal__dialog {
    max-width: 64rem;
  }

  .related-products-modal--large .related-products-modal__dialog {
    max-width: 90rem;
  }

  .related-products-modal--full .related-products-modal__dialog {
    max-width: calc(100vw - 3.2rem);
    max-height: calc(100vh - 3.2rem);
  }

  .related-products-modal--fade.is-open .related-products-modal__dialog,
  .related-products-modal--slide-up.is-open .related-products-modal__dialog,
  .related-products-modal--zoom.is-open .related-products-modal__dialog {
    transform: translateY(0) scale(1);
  }

  .related-products-modal--zoom .related-products-modal__dialog {
    transform: scale(0.92);
  }

  .related-products-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.6rem 1.6rem 0;
  }

  .related-products-modal__title {
    margin: 0;
    font-weight: 600;
  }

  .related-products-modal__close {
    flex-shrink: 0;
    width: 3.6rem;
    height: 3.6rem;
    border: 0;
    border-radius: 50%;
    background: rgba(18, 18, 18, 0.08);
    color: inherit;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .related-products-modal__body {
    padding: 1.6rem;
  }

  .related-products-modal__grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-products-modal__loading,
  .related-products-modal__empty {
    margin: 0;
    text-align: center;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .related-products-modal,
    .related-products-modal__dialog {
      transition: none;
    }
  }
</style>

<div
  class="related-products-modal-placeholder"
  {{ block.shopify_attributes }}
>
  Related products modal — opens on the product page after the open delay. Configure settings in this block.
</div>

<related-products-modal
  id="{{ modal_id }}"
  class="related-products-modal related-products-modal--{{ block.settings.modal_size | default: 'medium' }} related-products-modal--{{ block.settings.animation | default: 'fade' }}"
  data-url="{{ recommendations_url }}"
  data-open-delay="{{ block.settings.open_delay | default: 3 }}"
  data-auto-close="{{ block.settings.auto_close }}"
  data-auto-close-delay="{{ block.settings.auto_close_delay | default: 10 }}"
  data-show-once="{{ block.settings.show_once_per_session }}"
  data-close-on-overlay="{{ block.settings.close_on_overlay_click }}"
  data-close-on-escape="{{ block.settings.close_on_escape }}"
  data-block-id="{{ block.id }}"
  style="
    --rpm-overlay-color: {{ block.settings.overlay_color | default: '#000000' }};
    --rpm-overlay-opacity: {{ block.settings.overlay_opacity | default: 50 | divided_by: 100.0 }};
    --rpm-dialog-bg: {{ block.settings.dialog_background | default: '#ffffff' }};
    --rpm-dialog-text: {{ block.settings.dialog_text | default: '#121212' }};
  "
  hidden
>
  {%- if block.settings.show_overlay != false -%}
    <button
      type="button"
      class="related-products-modal__overlay"
      data-action="close"
      aria-label="{{ 'accessibility.close' | t }}"
      tabindex="-1"
    ></button>
  {%- endif -%}

  <div
    class="related-products-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ modal_id }}-title"
    tabindex="-1"
  >
    <div class="related-products-modal__header">
      {%- if block.settings.modal_title != blank -%}
        <h2
          id="{{ modal_id }}-title"
          class="related-products-modal__title {{ block.settings.heading_size | default: 'h2' }}"
        >
          {{ block.settings.modal_title }}
        </h2>
      {%- endif -%}

      {%- if block.settings.show_close_button != false -%}
        <button
          type="button"
          class="related-products-modal__close"
          data-action="close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span aria-hidden="true">&times;</span>
        </button>
      {%- endif -%}
    </div>

    <div class="related-products-modal__body" data-content>
      {%- if recommendations.performed -%}
        {%- if recommendations.products_count > 0 -%}
          <ul
            class="related-products-modal__grid grid product-grid grid--{{ block.settings.columns_desktop }}-col-desktop grid--{{ block.settings.columns_mobile }}-col-tablet-down"
            role="list"
            data-modal-products
          >
            {%- assign skip_card_product_styles = false -%}
            {%- for recommendation in recommendations.products limit: products_to_show -%}
              <li class="grid__item">
                {% render 'card-product',
                  card_product: recommendation,
                  media_aspect_ratio: block.settings.image_ratio,
                  show_secondary_image: block.settings.show_secondary_image,
                  show_vendor: block.settings.show_vendor,
                  show_rating: block.settings.show_rating,
                  skip_styles: skip_card_product_styles
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="related-products-modal__empty" data-empty>No related products found.</p>
        {%- endif -%}
      {%- else -%}
        <p class="related-products-modal__loading" data-loading>Loading...</p>
      {%- endif -%}
    </div>
  </div>
</related-products-modal>

<script>
  if (!customElements.get('related-products-modal')) {
    class RelatedProductsModal extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'related-products-modal-dismissed';
        this.openTimer = null;
        this.closeTimer = null;
        this.loaded = false;
      }

      connectedCallback() {
        if (this.dataset.showOnce === 'true' && sessionStorage.getItem(this.storageKey) === '1') {
          return;
        }

        if (window.Shopify && window.Shopify.designMode) {
          return;
        }

        const openDelay = Number(this.dataset.openDelay || 3) * 1000;
        this.openTimer = window.setTimeout(() => this.open(), openDelay);
      }

      disconnectedCallback() {
        this.clearTimers();
        this.removeListeners();
      }

      clearTimers() {
        if (this.openTimer) window.clearTimeout(this.openTimer);
        if (this.closeTimer) window.clearTimeout(this.closeTimer);
        this.openTimer = null;
        this.closeTimer = null;
      }

      addListeners() {
        this.onKeydown = (event) => {
          if (event.key === 'Escape' && this.dataset.closeOnEscape !== 'false') {
            this.close();
          }
        };

        this.onClick = (event) => {
          const closeTarget = event.target.closest('[data-action="close"]');
          if (!closeTarget) return;

          if (
            closeTarget.classList.contains('related-products-modal__overlay') &&
            this.dataset.closeOnOverlay === 'false'
          ) {
            return;
          }

          this.close();
        };

        document.addEventListener('keydown', this.onKeydown);
        this.addEventListener('click', this.onClick);
      }

      removeListeners() {
        if (this.onKeydown) document.removeEventListener('keydown', this.onKeydown);
        if (this.onClick) this.removeEventListener('click', this.onClick);
      }

      async open() {
        if (this.classList.contains('is-open')) return;

        this.removeAttribute('hidden');
        this.classList.add('is-open');
        this.addListeners();

        const dialog = this.querySelector('.related-products-modal__dialog');
        if (dialog) dialog.focus();

        if (!this.loaded) {
          await this.loadRecommendations();
        }

        if (this.dataset.autoClose === 'true') {
          const autoCloseDelay = Number(this.dataset.autoCloseDelay || 10) * 1000;
          this.closeTimer = window.setTimeout(() => this.close(), autoCloseDelay);
        }
      }

      close() {
        this.classList.remove('is-open');
        this.setAttribute('hidden', '');
        this.clearTimers();
        this.removeListeners();

        if (this.dataset.showOnce === 'true') {
          sessionStorage.setItem(this.storageKey, '1');
        }
      }

      async loadRecommendations() {
        const content = this.querySelector('[data-content]');
        const url = this.dataset.url;
        const blockId = this.dataset.blockId;

        if (!content || !url) return;

        if (content.querySelector('[data-modal-products]')) {
          this.loaded = true;
          return;
        }

        try {
          const response = await fetch(url);
          if (!response.ok) throw new Error('Failed to load recommendations');

          const html = await response.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const sourceModal = blockId
            ? doc.querySelector('related-products-modal[data-block-id="' + blockId + '"]')
            : doc.querySelector('related-products-modal');
          const sourceContent = sourceModal
            ? sourceModal.querySelector('[data-content]')
            : null;
          const products = sourceContent
            ? sourceContent.querySelector('[data-modal-products]')
            : null;

          if (products && products.querySelector('.grid__item')) {
            content.innerHTML = products.outerHTML;
            this.loaded = true;
          } else {
            content.innerHTML = '<p class="related-products-modal__empty">No related products found.</p>';
            window.setTimeout(() => this.close(), 2000);
          }
        } catch (error) {
          content.innerHTML = '<p class="related-products-modal__empty">Unable to load related products.</p>';
          window.setTimeout(() => this.close(), 2000);
        }
      }
    }

    customElements.define('related-products-modal', RelatedProductsModal);
  }
</script>
{%- endif -%}
