{% doc %}
Related products modal shell for the product page.
Loads the existing on-page related-products section via Recommendations API.
@param {product} product - Current product
@param {object} section - Related products modal section
@example
{% render 'related-products-modal', product: product, section: section %}
{% enddoc %}

{%- if product != blank and section != blank -%}
{%- liquid
  assign modal_id = 'related-products-modal-' | append: section.id
-%}

<style>
  .related-products-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.6rem;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .related-products-modal.is-open {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
  }

  .related-products-modal__overlay {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    margin: 0;
    background: var(--rpm-overlay-color);
    opacity: var(--rpm-overlay-opacity);
    cursor: pointer;
  }

  .related-products-modal__dialog {
    position: relative;
    z-index: 1;
    width: 100%;
    max-height: min(90vh, 720px);
    overflow: auto;
    background: var(--rpm-dialog-bg, #ffffff);
    color: var(--rpm-dialog-text, #121212);
    border-radius: 0.8rem;
    box-shadow: 0 1.6rem 4.8rem rgba(0, 0, 0, 0.18);
    transform: translateY(1.6rem) scale(0.98);
    transition: transform 0.3s ease;
  }

  .related-products-modal--small .related-products-modal__dialog {
    max-width: 42rem;
  }

  .related-products-modal--medium .related-products-modal__dialog {
    max-width: 64rem;
  }

  .related-products-modal--large .related-products-modal__dialog {
    max-width: 90rem;
  }

  .related-products-modal--full .related-products-modal__dialog {
    max-width: calc(100vw - 3.2rem);
    max-height: calc(100vh - 3.2rem);
  }

  .related-products-modal--fade.is-open .related-products-modal__dialog,
  .related-products-modal--slide-up.is-open .related-products-modal__dialog,
  .related-products-modal--zoom.is-open .related-products-modal__dialog {
    transform: translateY(0) scale(1);
  }

  .related-products-modal--zoom .related-products-modal__dialog {
    transform: scale(0.92);
  }

  .related-products-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.6rem 1.6rem 0;
  }

  .related-products-modal__title {
    margin: 0;
    font-size: 2rem;
    font-weight: 600;
  }

  .related-products-modal__close {
    flex-shrink: 0;
    width: 3.6rem;
    height: 3.6rem;
    border: 0;
    border-radius: 50%;
    background: rgba(18, 18, 18, 0.08);
    color: inherit;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .related-products-modal__body {
    padding: 1.6rem;
  }

  .related-products-modal__body .related-products {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  .related-products-modal__body .page-width {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  .related-products-modal--hide-related-heading .related-products-modal__body .related-products__heading {
    display: none;
  }

  .related-products-modal__loading,
  .related-products-modal__empty {
    margin: 0;
    text-align: center;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .related-products-modal,
    .related-products-modal__dialog {
      transition: none;
    }
  }
</style>

<related-products-modal
  id="{{ modal_id }}"
  class="related-products-modal related-products-modal--{{ section.settings.modal_size | default: 'medium' }} related-products-modal--{{ section.settings.animation | default: 'fade' }}{% if section.settings.hide_related_heading %} related-products-modal--hide-related-heading{% endif %}"
  data-product-id="{{ product.id }}"
  data-recommendations-base="{{ routes.product_recommendations_url }}"
  data-fallback-section-id="related-products"
  data-open-delay="{{ section.settings.open_delay | default: 3 }}"
  data-auto-close="{{ section.settings.auto_close }}"
  data-auto-close-delay="{{ section.settings.auto_close_delay | default: 10 }}"
  data-show-once="{{ section.settings.show_once_per_session }}"
  data-close-on-overlay="{{ section.settings.close_on_overlay_click }}"
  data-close-on-escape="{{ section.settings.close_on_escape }}"
  data-hide-page-related="{{ section.settings.hide_page_related_products }}"
  style="
    --rpm-overlay-color: {{ section.settings.overlay_color | default: '#000000' }};
    --rpm-overlay-opacity: {{ section.settings.overlay_opacity | default: 50 | divided_by: 100.0 }};
    --rpm-dialog-bg: {{ section.settings.dialog_background | default: '#ffffff' }};
    --rpm-dialog-text: {{ section.settings.dialog_text | default: '#121212' }};
  "
  hidden
>
  {%- if section.settings.show_overlay != false -%}
    <button
      type="button"
      class="related-products-modal__overlay"
      data-action="close"
      aria-label="{{ 'accessibility.close' | t }}"
      tabindex="-1"
    ></button>
  {%- endif -%}

  <div
    class="related-products-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ modal_id }}-title"
    tabindex="-1"
  >
    <div class="related-products-modal__header">
      {%- if section.settings.modal_title != blank -%}
        <h2 id="{{ modal_id }}-title" class="related-products-modal__title">
          {{ section.settings.modal_title }}
        </h2>
      {%- endif -%}

      {%- if section.settings.show_close_button != false -%}
        <button
          type="button"
          class="related-products-modal__close"
          data-action="close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span aria-hidden="true">&times;</span>
        </button>
      {%- endif -%}
    </div>

    <div class="related-products-modal__body" data-content>
      <p class="related-products-modal__loading" data-loading>Loading...</p>
    </div>
  </div>
</related-products-modal>

<script>
  if (!customElements.get('related-products-modal')) {
    class RelatedProductsModal extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'related-products-modal-dismissed';
        this.openTimer = null;
        this.closeTimer = null;
        this.loaded = false;
      }

      connectedCallback() {
        if (this.parentElement !== document.body) {
          document.body.appendChild(this);
        }

        this.applyPageRelatedVisibility();

        if (this.dataset.showOnce === 'true' && sessionStorage.getItem(this.storageKey) === '1') {
          return;
        }

        if (window.Shopify && window.Shopify.designMode) {
          return;
        }

        const openDelay = Number(this.dataset.openDelay || 3) * 1000;
        this.openTimer = window.setTimeout(() => this.open(), openDelay);
      }

      disconnectedCallback() {
        this.clearTimers();
        this.removeListeners();
      }

      getRelatedSource() {
        return document.querySelector('product-recommendations.related-products[data-section-id]');
      }

      getRelatedSectionId() {
        const source = this.getRelatedSource();
        return source ? source.dataset.sectionId : null;
      }

      buildRecommendationsUrl() {
        const base = this.dataset.recommendationsBase;
        const productId = this.dataset.productId;
        const sectionId = this.getRelatedSectionId() || this.dataset.fallbackSectionId;

        if (!base || !productId || !sectionId) return null;

        return (
          base +
          '?section_id=' +
          encodeURIComponent(sectionId) +
          '&product_id=' +
          encodeURIComponent(productId) +
          '&intent=related'
        );
      }

      applyPageRelatedVisibility() {
        if (this.dataset.hidePageRelated !== 'true') return;

        const sectionId = this.getRelatedSectionId();
        if (!sectionId) return;

        const pageSection = document.getElementById('shopify-section-' + sectionId);
        if (pageSection) {
          pageSection.style.display = 'none';
        }
      }

      clearTimers() {
        if (this.openTimer) window.clearTimeout(this.openTimer);
        if (this.closeTimer) window.clearTimeout(this.closeTimer);
        this.openTimer = null;
        this.closeTimer = null;
      }

      addListeners() {
        this.onKeydown = (event) => {
          if (event.key === 'Escape' && this.dataset.closeOnEscape !== 'false') {
            this.close();
          }
        };

        this.onClick = (event) => {
          const closeTarget = event.target.closest('[data-action="close"]');
          if (!closeTarget) return;

          if (
            closeTarget.classList.contains('related-products-modal__overlay') &&
            this.dataset.closeOnOverlay === 'false'
          ) {
            return;
          }

          this.close();
        };

        document.addEventListener('keydown', this.onKeydown);
        this.addEventListener('click', this.onClick);
      }

      removeListeners() {
        if (this.onKeydown) document.removeEventListener('keydown', this.onKeydown);
        if (this.onClick) this.removeEventListener('click', this.onClick);
      }

      async open() {
        if (this.classList.contains('is-open')) return;

        this.removeAttribute('hidden');
        this.classList.add('is-open');
        this.addListeners();

        const dialog = this.querySelector('.related-products-modal__dialog');
        if (dialog) dialog.focus();

        if (!this.loaded) {
          await this.loadRecommendations();
        }

        if (this.dataset.autoClose === 'true') {
          const autoCloseDelay = Number(this.dataset.autoCloseDelay || 10) * 1000;
          this.closeTimer = window.setTimeout(() => this.close(), autoCloseDelay);
        }
      }

      close() {
        this.classList.remove('is-open');
        this.setAttribute('hidden', '');
        this.clearTimers();
        this.removeListeners();

        if (this.dataset.showOnce === 'true') {
          sessionStorage.setItem(this.storageKey, '1');
        }
      }

      async loadRecommendations() {
        const content = this.querySelector('[data-content]');
        const url = this.buildRecommendationsUrl();

        if (!content || !url) {
          if (content) {
            content.innerHTML = '<p class="related-products-modal__empty">Related products section not found on this page.</p>';
          }
          return;
        }

        try {
          const response = await fetch(url);
          if (!response.ok) throw new Error('Failed to load recommendations');

          const html = await response.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const relatedProducts = doc.querySelector('.related-products');
          const loading = content.querySelector('[data-loading]');

          if (loading) loading.remove();

          if (relatedProducts && relatedProducts.querySelector('.grid__item')) {
            content.innerHTML = relatedProducts.outerHTML;
            this.loaded = true;
          } else {
            content.innerHTML = '<p class="related-products-modal__empty">No related products found.</p>';
            window.setTimeout(() => this.close(), 2000);
          }
        } catch (error) {
          content.innerHTML = '<p class="related-products-modal__empty">Unable to load related products.</p>';
          window.setTimeout(() => this.close(), 2000);
        }
      }
    }

    customElements.define('related-products-modal', RelatedProductsModal);
  }
</script>
{%- endif -%}
