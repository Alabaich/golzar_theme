{{ 'section-mp-pros.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section
  id="mp-process-steps-{{ section.id }}"
  class="mp-section mp-process-steps{% if s.media_position == 'left' %} mp-process-steps--media-left{% endif %} {{ s.custom_class }}"
  style="
    --mp-bg: {{ s.background_color }};
    --mp-heading: {{ s.heading_color }};
    --mp-text: {{ s.text_color }};
    --mp-pad-top: {{ s.padding_top }}px;
    --mp-pad-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="mp-section__inner mp-process-steps__layout">
    <div class="mp-process-steps__content">
      {% render 'mp_heading', text: s.heading, heading_tag: s.heading_tag %}

      <ol class="mp-process-steps__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <li class="mp-process-steps__item" {{ block.shopify_attributes }}>
              <div class="mp-process-steps__marker">
                <span class="mp-process-steps__num">{{ forloop.index }}</span>
                {%- unless forloop.last -%}
                  <span class="mp-process-steps__rail" aria-hidden="true"></span>
                {%- endunless -%}
              </div>
              <div>
                {% render 'mp_heading',
                  text: block.settings.title,
                  heading_tag: block.settings.title_tag,
                  class: 'mp-process-steps__item-title'
                %}
                {%- if block.settings.text != blank -%}
                  <p class="mp-process-steps__item-body">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>

      <div class="mp-process-steps__cta">
        {% render 'mp_button', label: s.cta_label, url: s.cta_link, style: 'primary' %}
      </div>
    </div>

    <div class="mp-process-steps__media">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600,900,1200', alt: s.heading
        }}
      {%- else -%}
        <img src="{{ 'mp-process-bg.png' | asset_url }}" alt="" width="800" height="1000" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MP Process Steps",
  "tag": "section",
  "class": "mp-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Side image" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How the Golzar Home Trade Program Works" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Apply for a Trade Account" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#061d32" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        {
          "type": "select",
          "id": "title_tag",
          "label": "Title tag",
          "options": [
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "p", "label": "Paragraph" }
          ],
          "default": "h3"
        },
        { "type": "textarea", "id": "text", "label": "Body", "default": "Describe this step." }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  },
  "presets": [
    {
      "name": "MP Process Steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose Your Request", "text": "Apply for an ongoing trade account or submit a defined product list for project-pricing review." } },
        { "type": "step", "settings": { "title": "Share Your Details", "text": "Tell us about your business, professional role, location and the products you need." } },
        { "type": "step", "settings": { "title": "Complete the Review", "text": "The team reviews the account application or project information and identifies any additional details required." } },
        { "type": "step", "settings": { "title": "Review Pricing & Order Details", "text": "Review any applicable pricing, available product information and pickup or shipping requirements." } },
        { "type": "step", "settings": { "title": "Confirm the Order", "text": "Confirm models, finishes, quantities, payment details and the agreed pickup or shipping method." } },
        { "type": "step", "settings": { "title": "Arrange Pickup or Shipping", "text": "Collect your order in Vaughan or arrange shipping, then contact the team with order concerns." } }
      ]
    }
  ]
}
{% endschema %}
