{{ 'section-three-prom-blocks.css' | asset_url | stylesheet_tag }}

<div class="hs-three">
  <div class="page-width pageWidth">
    <div class="hs-three-blocks-section">
      {% assign first_image = true %}
      {% for block in section.blocks %}
        {% if block.type == 'promo_block' %}
          <div class="hs-block-item">
            <a href="{{ block.settings.button_url }}">
              {% if block.settings.image != blank %}
                {% if first_image %}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'hs-three-image',
                      alt: block.settings.heading,
                      loading: 'eager',
                      fetchpriority: 'high',
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      widths: '400, 600, 800'
                  }}
                  {% assign first_image = false %}
                {% else %}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'hs-three-image',
                      alt: block.settings.heading,
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      widths: '400, 600, 800'
                  }}
                {% endif %}
              {% endif %}
              <div class="hs-block-content">
                <div class="hs-block-content-top">
                  <h3>{{ block.settings.heading }}</h3>
                  <p>{{ block.settings.text }}</p>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three Promo Blocks",
  "class": "index-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Add up to 3 promo blocks with full image links"
    }
  ],
  "blocks": [
    {
      "type": "promo_block",
      "name": "Promo Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Block Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Block Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Block Text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Block Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three Promo Blocks",
      "category": "Custom",
      "blocks": [
        {
          "type": "promo_block"
        },
        {
          "type": "promo_block"
        },
        {
          "type": "promo_block"
        }
      ]
    }
  ]
}
{% endschema %}
