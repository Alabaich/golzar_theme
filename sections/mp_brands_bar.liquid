{{ 'section-mp-pros.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section
  id="mp-brands-bar-{{ section.id }}"
  class="mp-section mp-brands-bar {{ s.custom_class }}"
  style="
    --mp-bg: {{ s.background_color }};
    --mp-heading: {{ s.heading_color }};
    --mp-text: {{ s.text_color }};
    --mp-pad-top: {{ s.padding_top }}px;
    --mp-pad-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="mp-section__inner">
    <header class="mp-section__header">
      {% render 'mp_heading', text: s.heading, heading_tag: s.heading_tag %}
      {%- if s.cta_label != blank -%}
        <div class="mp-category-tiles__actions">
          {% render 'mp_button', label: s.cta_label, url: s.cta_link, style: 'secondary', class: 'mp-button--outline-dark' %}
        </div>
      {%- endif -%}
    </header>

    <div class="mp-brands-bar__logos">
      {%- for block in section.blocks -%}
        {%- if block.type == 'logo' -%}
          {%- liquid
            assign logo_alt = block.settings.title | default: 'Brand'
          -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 280
                  | image_tag: class: 'mp-brands-bar__logo', loading: 'lazy', alt: logo_alt, widths: '140,280'
                }}
              {%- elsif block.settings.asset != blank -%}
                <img class="mp-brands-bar__logo" src="{{ block.settings.asset | asset_url }}" alt="{{ logo_alt | escape }}" height="40" loading="lazy">
              {%- endif -%}
            </a>
          {%- else -%}
            <span {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 280
                  | image_tag: class: 'mp-brands-bar__logo', loading: 'lazy', alt: logo_alt, widths: '140,280'
                }}
              {%- elsif block.settings.asset != blank -%}
                <img class="mp-brands-bar__logo" src="{{ block.settings.asset | asset_url }}" alt="{{ logo_alt | escape }}" height="40" loading="lazy">
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="mp-brands-bar__info mp-info-row mp-info-row--info-bar">
      <div class="mp-info-row__track">
        {%- for block in section.blocks -%}
          {%- if block.type == 'info' -%}
            <div class="mp-info-row__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 48
                  | image_tag: class: 'mp-info-row__icon', loading: 'lazy', alt: ''
                }}
              {%- elsif block.settings.icon_asset != blank -%}
                <img class="mp-info-row__icon" src="{{ block.settings.icon_asset | asset_url }}" alt="" width="20" height="20" loading="lazy">
              {%- endif -%}
              <div class="mp-info-row__item-text">
                {%- if block.settings.title != blank -%}
                  <strong>{{ block.settings.title | escape }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span>{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  /* Outline CTA on light brands section */
  #mp-brands-bar-{{ section.id }} .mp-button--secondary,
  #mp-brands-bar-{{ section.id }} .mp-button--outline-dark {
    color: {{ s.heading_color }};
    border-color: {{ s.heading_color }};
    background: transparent;
  }
{% endstyle %}

{% schema %}
{
  "name": "MP Brands Bar",
  "tag": "section",
  "class": "mp-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brands Available at Golzar Home" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View All Brands" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#061d32" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#5c5c5c" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "asset", "label": "Theme asset filename", "info": "e.g. mp-logo-kohler.png" },
        { "type": "text", "id": "title", "label": "Alt text", "default": "Brand" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "info",
      "name": "Info item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "icon_asset", "label": "Theme asset filename" },
        { "type": "text", "id": "title", "label": "Title", "default": "SECURE ONLINE PAYMENTS" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Major credit cards, eligible debit cards and Apple Pay are accepted for online purchases." }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  },
  "presets": [
    {
      "name": "MP Brands Bar",
      "blocks": [
        { "type": "logo", "settings": { "asset": "mp-logo-riobel.png", "title": "Riobel" } },
        { "type": "logo", "settings": { "asset": "mp-logo-kohler.png", "title": "Kohler" } },
        { "type": "logo", "settings": { "asset": "mp-logo-delta.png", "title": "Delta" } },
        { "type": "logo", "settings": { "asset": "mp-logo-toto.png", "title": "Toto" } },
        { "type": "logo", "settings": { "asset": "mp-logo-grohe.png", "title": "Grohe" } },
        { "type": "logo", "settings": { "asset": "mp-logo-maax.png", "title": "Maax" } },
        {
          "type": "info",
          "settings": {
            "icon_asset": "mp-icon-lock.svg",
            "title": "SECURE ONLINE PAYMENTS",
            "text": "Major credit cards, eligible debit cards and Apple Pay are accepted for online purchases."
          }
        },
        {
          "type": "info",
          "settings": {
            "icon_asset": "mp-icon-help.svg",
            "title": "PRODUCT & PROJECT HELP",
            "text": "Ask about product details, finishes, quantities and order questions."
          }
        },
        {
          "type": "info",
          "settings": {
            "icon_asset": "mp-icon-truck.svg",
            "title": "PICKUP & SHIPPING OPTIONS",
            "text": "Arrange eligible Vaughan pickup or shipping based on the order and destination."
          }
        }
      ]
    }
  ]
}
{% endschema %}
