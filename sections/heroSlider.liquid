{{ 'section-heroSlider.css' | asset_url | stylesheet_tag }}
{{ 'splide.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'splide.min.js' | asset_url }}" defer></script>

{% comment %} <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@latest/dist/css/splide.min.css"> {% endcomment %}
{% comment %} <script async src="https://cdn.jsdelivr.net/npm/@splidejs/splide@latest/dist/js/splide.min.js"></script> {% endcomment %}

<div class="hs-hero-slider splide page-width pageWidth">
  <div class="splide__track">
    <ul class="splide__list">
      {% assign first_slide_image = true %}
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          {% assign image = block.settings.image %}
          {% assign heading = block.settings.heading %}
          {% comment %} {% assign button_label = block.settings.button_label %} {% endcomment %}
          {% assign button_url = block.settings.button_url %}
          {% assign img_object_fit = block.settings.img_object_fit | default: 'cover' %}
          {% assign target_url = block.settings.url_type | default: '_self' %}
          {% assign custom_classes = block.settings.custom_classes %}
          {% assign image_src = image | image_url: width: 1600 %}
          {% if image_src contains '/cdn/' %}
            {% assign image_src = image_src | split: '/cdn/' | last | prepend: 'https://bathroomsupplier.ca/cdn/' %}
          {% elsif image_src contains '/s/files/' %}
            {% assign image_src = image_src | split: '/s/files/' | last | prepend: 'https://bathroomsupplier.ca/s/files/' %}
          {% elsif image_src contains '//' %}
            {% assign image_src = image_src | split: '//' | last | prepend: 'https://' %}
          {% endif %}
          {% if image != blank and button_url != blank %}
            <li class="splide__slide {{ custom_classes }}" title="{{ heading }}">
              <a
                href="{{ button_url }}"
                target="{{ target_url }}"
                class="hs-slide-link btn-url"
              >
                <img
                  src="{{ image_src }}"
                  alt="{{ heading }}"
                  title="{{ heading }}"
                  style="object-fit: {{ img_object_fit }};"
                  width="auto"
                  height="auto"
                  class="hero-slide-img"
                  {% if first_slide_image %}
                    fetchpriority="high"
                    data-fetch-priority
                    {% assign first_slide_image = false %}
                  {% endif %}
                >
                  
                <div class="hs-slide-content">
                  {% comment %} <h2>{{ heading }}</h2> {% endcomment %}
                </div>
              </a>
            </li>
          {% else %}
            <li class="splide__slide" title="{{ heading }}">
              <img
                src="{{ image_src }}"
                alt="{{ heading }}"
                title="{{ heading }}"
                width="auto"
                height="auto"
                {% if first_slide_image %}fetchpriority="high"{% assign first_slide_image = false %}{% endif %}
              >
              <div class="hs-slide-content">
                {% comment %} <h2>{{ heading }}</h2> {% endcomment %}
              </div>
            </li>
          {% endif %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Splide('.splide', {
      type: 'loop',
      gap: '25px',
      autoplay: true,
      interval: 4000,
      pauseOnHover: false,
      pauseOnFocus: true,
      heightRatio : 0.4,
      pagination: false,
      {% comment %} lazyLoad: 'nearby',
      preloadPages: 1, {% endcomment %}
    }).mount();
  });
</script>

{% schema %}
  {
    "name": "Hero Slider",
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Slide Image"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Slide Heading",
            "default": "Your Heading Here"
          },
          {
            "type": "text",
            "id": "button_label",
            "label": "Button Label",
            "default": "Shop Now"
          },
          {
            "type": "url",
            "id": "button_url",
            "label": "Button URL"
          },
          {
            "type": "select",
            "id": "url_type",
            "label": "URL Type",
            "options": [
              {
                "value": "_self",
                "label": "Internal"
              },
              {
                "value": "_blank",
                "label": "External"
              }
            ],
            "default": "_self"
          },
          {
            "type": "select",
            "id": "img_object_fit",
            "label": "Object Fit",
            "options": [
              {
                "value": "cover",
                "label": "Cover"
              },
              {
                "value": "contain",
                "label": "Contain"
              }
            ],
            "default": "cover"
          },
          {
            "type": "text",
            "id": "custom_classes",
            "label": "Custom Classes"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Hero Slider",
        "category": "Slideshow",
        "blocks": [
          {
            "type": "slide"
          },
          {
            "type": "slide"
          }
        ]
      }
    ]
  }
{% endschema %}