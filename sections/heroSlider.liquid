{{ 'section-heroSlider.css' | asset_url | stylesheet_tag }}
{{ 'splide.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'splide.min.js' | asset_url }}" defer></script>

{% comment %} <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@latest/dist/css/splide.min.css"> {% endcomment %}
{% comment %} <script async src="https://cdn.jsdelivr.net/npm/@splidejs/splide@latest/dist/js/splide.min.js"></script> {% endcomment %}

<div class="hs-hero-slider splide page-width pageWidth">
  <div class="splide__track">
    <ul class="splide__list">
      {% assign first_slide_image = true %}
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          {% assign image = block.settings.image %}
          {% assign heading = block.settings.heading %}
          {% comment %} {% assign button_label = block.settings.button_label %} {% endcomment %}
          {% assign button_url = block.settings.button_url %}
          {% assign img_object_fit = block.settings.img_object_fit | default: 'cover' %}
          {% assign target_url = block.settings.url_type | default: '_self' %}
          {% assign custom_classes = block.settings.custom_classes %}
          {% assign img_style = 'object-fit: ' | append: img_object_fit | append: ';' %}
          {% if image != blank %}
            {% if first_slide_image %}
              {% capture slide_image %}
                {{
                  image
                  | image_url: width: 1600
                  | image_tag:
                    class: 'hero-slide-img',
                    alt: heading,
                    title: heading,
                    style: img_style,
                    loading: 'eager',
                    fetchpriority: 'high',
                    sizes: '100vw',
                    widths: '750, 990, 1200, 1400, 1600'
                }}
              {% endcapture %}
              {% assign first_slide_image = false %}
            {% else %}
              {% capture slide_image %}
                {{
                  image
                  | image_url: width: 1600
                  | image_tag:
                    class: 'hero-slide-img',
                    alt: heading,
                    title: heading,
                    style: img_style,
                    loading: 'lazy',
                    sizes: '100vw',
                    widths: '750, 990, 1200, 1400, 1600'
                }}
              {% endcapture %}
            {% endif %}
            {% if button_url != blank %}
              <li class="splide__slide {{ custom_classes }}" title="{{ heading }}">
                <a
                  href="{{ button_url }}"
                  target="{{ target_url }}"
                  class="hs-slide-link btn-url"
                >
                  {{ slide_image }}
                  <div class="hs-slide-content">
                    {% comment %} <h2>{{ heading }}</h2> {% endcomment %}
                  </div>
                </a>
              </li>
            {% else %}
              <li class="splide__slide {{ custom_classes }}" title="{{ heading }}">
                {{ slide_image }}
                <div class="hs-slide-content">
                  {% comment %} <h2>{{ heading }}</h2> {% endcomment %}
                </div>
              </li>
            {% endif %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Splide('.splide', {
      type: 'loop',
      gap: '25px',
      autoplay: true,
      interval: 4000,
      pauseOnHover: false,
      pauseOnFocus: true,
      heightRatio : 0.4,
      pagination: false,
      {% comment %} lazyLoad: 'nearby',
      preloadPages: 1, {% endcomment %}
    }).mount();
  });
</script>

{% schema %}
{
  "name": "Hero Slider",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Slide Heading",
          "default": "Your Heading Here"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "url_type",
          "label": "URL Type",
          "options": [
            {
              "value": "_self",
              "label": "Internal"
            },
            {
              "value": "_blank",
              "label": "External"
            }
          ],
          "default": "_self"
        },
        {
          "type": "select",
          "id": "img_object_fit",
          "label": "Object Fit",
          "options": [
            {
              "value": "cover",
              "label": "Cover"
            },
            {
              "value": "contain",
              "label": "Contain"
            }
          ],
          "default": "cover"
        },
        {
          "type": "text",
          "id": "custom_classes",
          "label": "Custom Classes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "category": "Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
