{{ 'section-mp-pros.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign variant = s.layout_variant | default: 'path'
  assign arrow = 'mp-icon-arrow-right.svg' | asset_url
-%}

<section
  id="mp-icon-cards-{{ section.id }}"
  class="mp-section mp-icon-cards mp-icon-cards--{{ variant }} {{ s.custom_class }}"
  style="
    --mp-bg: {{ s.background_color }};
    --mp-heading: {{ s.heading_color }};
    --mp-text: {{ s.text_color }};
    --mp-card-bg: {{ s.card_bg }};
    --mp-card-text: {{ s.card_text }};
    --mp-card-border: {{ s.card_border }};
    --mp-icon-bg: {{ s.icon_bg }};
    --mp-accent: {{ s.link_color }};
    --mp-gap: {{ s.gap }}px;
    --mp-pad-top: {{ s.padding_top }}px;
    --mp-pad-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="mp-section__inner">
    {%- if s.heading != blank or s.subheading != blank -%}
      <header class="mp-section__header{% if s.header_align == 'left' %} mp-section__header--left{% endif %}">
        {% render 'mp_heading', text: s.heading, heading_tag: s.heading_tag %}
        {%- if s.subheading != blank -%}
          <p class="mp-section__subcopy">{{ s.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="mp-icon-cards__grid">
      {%- for block in section.blocks -%}
        <article class="mp-icon-cards__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank or block.settings.icon_asset != blank -%}
            <div class="mp-icon-cards__icon-wrap">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 96
                  | image_tag: loading: 'lazy', widths: '48,96', alt: ''
                }}
              {%- else -%}
                <img src="{{ block.settings.icon_asset | asset_url }}" alt="" width="24" height="24" loading="lazy">
              {%- endif -%}
            </div>
          {%- endif -%}

          {% render 'mp_heading',
            text: block.settings.title,
            heading_tag: block.settings.title_tag,
            class: 'mp-icon-cards__title'
          %}

          {%- if block.settings.text != blank -%}
            <p class="mp-icon-cards__body">{{ block.settings.text | escape }}</p>
          {%- endif -%}

          {%- if block.settings.link_label != blank -%}
            <a class="mp-icon-cards__link" href="{{ block.settings.link | default: '#' }}">
              {{ block.settings.link_label | escape }}
              <img src="{{ arrow }}" alt="" width="14" height="14" loading="lazy">
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MP Icon Cards",
  "tag": "section",
  "class": "mp-section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "layout_variant",
      "label": "Layout variant",
      "options": [
        { "value": "path", "label": "Path cards (audience)" },
        { "value": "support", "label": "Support cards" },
        { "value": "mosaic", "label": "Feature mosaic (dark)" }
      ],
      "default": "path"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose the Professional Support That Fits Your Work" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Golzar Home works with contractors, builders and design professionals whose projects require clear product information, clear order details and practical delivery options."
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#061d32" },
    { "type": "color", "id": "text_color", "label": "Subheading color", "default": "#5c5c5c" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_text", "label": "Card text", "default": "#5c5c5c" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#e5e5e5" },
    { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#e8eef4" },
    { "type": "color", "id": "link_color", "label": "Link color", "default": "#c8102e" },
    { "type": "range", "id": "gap", "min": 8, "max": 48, "step": 4, "unit": "px", "label": "Grid gap", "default": 24 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "icon_asset", "label": "Theme asset filename", "info": "e.g. mp-icon-toolbox.svg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        {
          "type": "select",
          "id": "title_tag",
          "label": "Title tag",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "p", "label": "Paragraph" }
          ],
          "default": "h3"
        },
        { "type": "textarea", "id": "text", "label": "Body", "default": "Describe this audience or benefit." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link URL" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  },
  "presets": [
    {
      "name": "MP Icon Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon_asset": "mp-icon-toolbox.svg",
            "title": "CONTRACTORS & PLUMBERS",
            "text": "Submit fixture lists for pricing, ask about current availability, and review available product information before installation.",
            "link_label": "Explore Contractor & Plumber Support"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon_asset": "mp-icon-home.svg",
            "title": "BUILDERS & DEVELOPERS",
            "text": "Plan product selections for new construction, multi-unit developments and phased work.",
            "link_label": "Explore Builder & Developer Support"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon_asset": "mp-icon-pen.svg",
            "title": "DESIGNERS & ARCHITECTS",
            "text": "Compare products by style, finish, dimensions and configuration. Review selected items at the Vaughan showroom.",
            "link_label": "Explore Designer & Architect Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
